    given-names: "Ivan"
    affiliation: "OpenSystems, Universitat de Barcelona"
    orcid: "https://orcid.org/0009-0003-6168-7459"
version: 0.1.0
date-released: 2026-10-16
license: MIT
repository-code: "https://github.com/ivancasanovaas/degurba_world"
keywords:
  - degree of urbanisation
  - DEGURBA
  - urban-rural classification
  - GHSL
  - postcodes
  - geocoding
